{
  "name": "dsh-mini",
  "version": "0.2.0",
  "description": "DSH Mini: use DeepSeek Harness from any web page. Cordis plugin (Host + Web UI) that pairs with the standalone Chrome extension in chrome-extension/.",
  "keywords": [
    "deepseek",
    "deepseek-harness",
    "dsh-plugin",
    "dsh-bundle",
    "chrome-extension",
    "selection",
    "side-panel"
  ],
  "type": "module",
  "main": "./lib/index.js",
  "types": "./lib/types/index.d.ts",
  "exports": {
    ".": {
      "types": "./lib/types/index.d.ts",
      "default": "./lib/index.js"
    },
    "./client": "./lib/client.js",
    "./cordis.patch.yml": "./cordis.patch.yml",
    "./package.json": "./package.json"
  },
  "files": [
    "lib",
    "src",
    "cordis.patch.yml",
    "README.md",
    "README.zh.md",
    "README.i18n.yaml",
    "CHANGELOG.md",
    "LICENSE"
  ],
  "license": "BSD-3-Clause",
  "engines": {
    "node": "^20.0.0 || >=22.0.0"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/bill9109/dsh-mini.git"
  },
  "homepage": "https://github.com/bill9109/dsh-mini#readme",
  "bugs": {
    "url": "https://github.com/bill9109/dsh-mini/issues"
  },
  "scripts": {
    "build": "node scripts/build.mjs",
    "test": "node scripts/test.mjs",
    "test:extension": "cd chrome-extension && npm test",
    "verify:i18n": "node scripts/verify-i18n.mjs"
  },
  "dependencies": {
    "ws": "8.21.3"
  },
  "peerDependencies": {
    "@deepseek-ai/dsh-llm": ">=0.2.0-0",
    "@deepseek-ai/dsh-session": ">=0.2.0-0"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "inject": [
        "@deepseek-ai/dsh-client-ui-settings",
        "@deepseek-ai/dsh-client-ui-workspace"
      ]
    }
  }
}
